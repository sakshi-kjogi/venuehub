generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  VENUE_OWNER
  VENDOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  bio          String?
  avatarUrl    String?
  city         String?
  country      String?
  role         Role     @default(CUSTOMER)
  refreshToken String?
  venues       Venue[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Venue {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  name        String
  description String
  address     String
  city        String
  country     String
  capacity    Int
  pricePerDay Decimal      @db.Decimal(10, 2)
  amenities   String[]
  images      VenueImage[]
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("venues")
}

model VenueImage {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("venue_images")
}